# Copy to `.env.local` in `apps/host-app` when overriding defaults.

# Origin serving admin-app remoteEntry (dev default: 3001)
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001

# Optional: slow down mock user/preferences API (ms, max 5000). Useful when demoing loading states.
# NEXT_PUBLIC_MOCK_API_DELAY_MS=800

# Optional: doubles mock delay (pairs with NEXT_PUBLIC_MOCK_API_DELAY_MS)
# NEXT_PUBLIC_FLAG_SLOW_MOCK=1

# Optional: JSON POST target for trackClientEvent (sendBeacon). Leave unset to log in dev only.
# NEXT_PUBLIC_TELEMETRY_INGEST_URL=https://example.com/ingest
